# ── Gemini API (required for AI discovery + sales intelligence) ──────────────
GEMINI_API_KEY=your_gemini_api_key_here

# ── Google Sheets Integration (optional) ────────────────────────────────────
# The ID from your spreadsheet URL:
# https://docs.google.com/spreadsheets/d/<SPREADSHEET_ID>/edit
GOOGLE_SHEETS_SPREADSHEET_ID=your_spreadsheet_id_here

# Path to your Google Service Account JSON key file
# Download from: Google Cloud Console → IAM → Service Accounts → Keys
GOOGLE_SERVICE_ACCOUNT_JSON=service_account.json

# ── Run File Output (optional) ───────────────────────────────────────────────
# Directory where timestamped per-run CSV files are saved (default: runs/)
RUNS_DIR=runs
